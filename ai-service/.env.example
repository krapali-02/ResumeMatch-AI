# ResumeMatch AI — Python AI Service Environment Configuration

APP_NAME="ResumeMatch AI - Python AI Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
DEBUG=false

# Allowed Origins for CORS (private to application environment)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5000","http://127.0.0.1:3000","http://127.0.0.1:5000"]

# Maximum input payload text length in characters (default: 150,000)
MAX_INPUT_TEXT_LENGTH=150000

# Embedding model configuration
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL_CACHE_DIR="models_cache"

# Set to true for offline or lightweight test executions without heavy downloads
MOCK_EMBEDDINGS=false
