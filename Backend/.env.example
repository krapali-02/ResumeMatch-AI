NODE_ENV=development
PORT=5000

# Database Configuration
# Option A: MongoDB Atlas (Recommended for cloud/remote)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Option B: Local MongoDB instance (Requires MongoDB running locally on port 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/resumematch

# JWT Secrets (replace with secure random strings in production)
JWT_ACCESS_SECRET=change_this_access_secret_min_10_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_10_chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

# Resume Upload Configuration
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads